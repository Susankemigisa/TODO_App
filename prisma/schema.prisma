generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  avatar    String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  todos     Todo[]
  tags      Tag[]
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6B7280")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos     TodoTag[]
  createdAt DateTime @default(now())
}

model Todo {
  id          String      @id @default(uuid())
  title       String
  notes       String?
  done        Boolean     @default(false)
  priority    Priority    @default(MEDIUM)
  dueDate     DateTime?
  recurrence  Recurrence  @default(NONE)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  tags        TodoTag[]
}

model Subtask {
  id        String   @id @default(uuid())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TodoTag {
  todoId String
  tagId  String
  todo   Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([todoId, tagId])
}